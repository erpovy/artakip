# Veritabanı (PostgreSQL)
DATABASE_URL="postgresql://artakip:artakip_secret@localhost:5432/artakip?schema=public"

# Redis (BullMQ kuyruk ve zamanlayıcı)
REDIS_URL="redis://localhost:6379"

# Uygulama & NextAuth
NEXTAUTH_URL="https://artakip.artovy.com"
NEXTAUTH_SECRET="change-me-in-production-to-a-32-char-random-secret"
NEXT_PUBLIC_APP_URL="https://artakip.artovy.com"

# Worker Ayarları
WORKER_CONCURRENCY="20"

# SMTP E-posta Ayarları (Resend / Brevo / Mailgun / Özel SMTP)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="apikey"
SMTP_PASS="your-smtp-password"
SMTP_FROM="Artakip Uptime <bildirim@example.com>"

# Ödeme (Stripe / iyzico)
STRIPE_SECRET_KEY="sk_test_placeholder"
STRIPE_WEBHOOK_SECRET="whsec_placeholder"
STRIPE_PRICE_STARTER="price_starter_placeholder"
STRIPE_PRICE_PRO="price_pro_placeholder"
STRIPE_PRICE_AGENCY="price_agency_placeholder"

# Admin Başlangıç Hesabı (Seed için)
